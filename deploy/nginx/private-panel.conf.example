server {
    listen 80;
    server_name PANEL_HOST;
    location ^~ /.well-known/acme-challenge/ { root /var/www/pgclock-acme; }
    location / { return 308 https://PANEL_HOST$request_uri; }
}

server {
    listen 443 ssl;
    server_name PANEL_HOST;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32m;

    proxy_set_header Host PANEL_HOST;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Accept-Encoding "";
    proxy_cookie_path / "/; Secure";

    location = /panel-ENTRY_PATH_KEY {
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        add_header Set-Cookie "pgclock_entry=ENTRY_COOKIE_KEY; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=2592000" always;
        proxy_pass http://127.0.0.1:9000/login;
        sub_filter 'action="/login"' 'action="/panel-ENTRY_PATH_KEY"';
    }

    location = /login {
        if ($cookie_pgclock_entry != "ENTRY_COOKIE_KEY") { return 404; }
        return 303 /panel-ENTRY_PATH_KEY$is_args$args;
    }

    location / {
        proxy_pass http://127.0.0.1:9000;
    }
}
